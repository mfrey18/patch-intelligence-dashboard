# Local development; keep real credentials in ignored environment files.
DATABASE_URL=postgresql://patch_writer:REPLACE@127.0.0.1:5432/patch_intelligence
READ_DATABASE_URL=postgresql://patch_reader:REPLACE@127.0.0.1:5432/patch_intelligence
MIGRATION_DATABASE_URL=postgresql://patch_owner:REPLACE@127.0.0.1:5432/patch_intelligence
INGEST_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_DASHBOARD_ORIGINS=http://localhost:4173,https://mfrey18.github.io
PUBLIC_PORT=3001
PRIVATE_PORT=3002
PRIVATE_API_BASE_URL=http://127.0.0.1:3002
VITE_API_BASE_URL=http://127.0.0.1:3001
PATCH_DATA_ROOT=/Library/PatchIntelligence
# Cisco is one of the six cutover-gated production sources.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
# Other authoritative configured feeds remain optional; see .dev.vars.example.
