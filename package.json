{
  "name": "patch-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "pnpm run pages:build",
    "start": "node --import tsx server/index.ts",
    "pages:dev": "vite --config static-dashboard/vite.config.mjs --configLoader native",
    "pages:build": "vite build --config static-dashboard/vite.config.mjs --configLoader native",
    "pages:preview": "vite preview --config static-dashboard/vite.config.mjs --configLoader native",
    "test": "pnpm run test:unit && pnpm run test:postgres",
    "test:focused": "pnpm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate",
    "test:rendered": "node --import tsx --test tests/rendered-html.test.mjs",
    "test:pages": "node --test --test-isolation=none tests/pages-build.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test:postgres": "node --import tsx --test --test-concurrency=1 tests/postgres/*.test.mjs",
    "test:unit": "node --import tsx --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
